{
  "name": "siwes-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "lint": "eslint app src tests prisma --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bot:dev": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs --env-file=.env src/adapters/telegram/polling.ts",
    "bot:setup": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs --env-file=.env scripts/setup-telegram.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.61.0",
    "@prisma/client": "6.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "^12.38.0",
    "grammy": "1.38.0",
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "3.4.17",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.17.12",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.2",
    "jsdom": "24.1.3",
    "postcss": "8.5.28",
    "prisma": "6.12.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
